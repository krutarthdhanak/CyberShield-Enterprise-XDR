from flask import Flask, render_template, request, send_file
import os
import json

from scanner.validator import validate_target
from scanner.port_scanner import scan_ports
from scanner.report import generate_report
from scanner.database import (
    initialize_database,
    save_scan,
    get_history
)

from usb.usb_scanner import scan_usb

app = Flask(__name__)

initialize_database()

last_target = None
last_target_type = None
last_ports = []
last_start_port = None
last_end_port = None


@app.route("/")
def home():

    usb_path = "/mnt/usb"
    usb_connected = os.path.ismount(usb_path)

    scans = get_history()
    usb_risk = None

    total_scans = len(scans)

    total_open_ports = 0
    high_risk = 0
    medium_risk = 0
    low_risk = 0

    for scan in scans:

        ports = scan[3]

        if ports:

            port_list = ports.split(",")

            total_open_ports += len(port_list)

            for port in port_list:

                try:
                    p = int(port.strip())
                except:
                    continue

                if p in [23, 445, 3389]:
                    high_risk += 1

                elif p in [21, 80]:
                    medium_risk += 1

                else:
                    low_risk += 1

    security_score = max(
        0,
        100 - (high_risk * 10 + medium_risk * 5 + low_risk)
    )

    return render_template(
        "index.html",
        usb_connected=usb_connected,
        usb_mount=usb_path,
        total_scans=total_scans,
        total_open_ports=total_open_ports,
        high_risk=high_risk,
        medium_risk=medium_risk,
        low_risk=low_risk,
        security_score=security_score,
        usb_risk=None,
    )


@app.route("/scan", methods=["POST"])
def scan():

    global last_target
    global last_target_type
    global last_ports
    global last_start_port
    global last_end_port

    target = request.form["target"]

    start_port = int(request.form["start_port"])
    end_port = int(request.form["end_port"])

    valid, target_type = validate_target(target)

    if not valid:
        return "<h2>Invalid IP Address or Domain</h2>"

    if start_port < 1 or end_port > 65535:
        return "<h2>Port numbers must be between 1 and 65535.</h2>"

    if start_port > end_port:
        return "<h2>Start Port must be less than End Port.</h2>"

    ports = scan_ports(
        target,
        start_port,
        end_port
    )

    last_target = target
    last_target_type = target_type
    last_ports = ports
    last_start_port = start_port
    last_end_port = end_port

    save_scan(
        target,
        target_type,
        ports
    )

    scans = get_history()

    total_scans = len(scans)

    total_open_ports = 0
    high_risk = 0
    medium_risk = 0
    low_risk = 0

    for scan_item in scans:

        saved_ports = scan_item[3]

        if saved_ports:

            plist = saved_ports.split(",")

            total_open_ports += len(plist)

            for port in plist:

                try:
                    p = int(port.strip())
                except:
                    continue

                if p in [23, 445, 3389]:
                    high_risk += 1

                elif p in [21, 80]:
                    medium_risk += 1

                else:
                    low_risk += 1

    security_score = max(
        0,
        100 - (high_risk * 10 + medium_risk * 5 + low_risk)
    )

    usb_path = "/mnt/usb"
    usb_connected = os.path.ismount(usb_path)

    return render_template(
        "index.html",
        target=target,
        target_type=target_type,
        ports=ports,
        start_port=start_port,
        end_port=end_port,
        usb_connected=usb_connected,
        usb_mount=usb_path,
        total_scans=total_scans,
        total_open_ports=total_open_ports,
        high_risk=high_risk,
        medium_risk=medium_risk,
        low_risk=low_risk,
        security_score=security_score,
        usb_risk=None,
    )


@app.route("/usb_scan")
def usb_scan_route():

    usb_path = "/mnt/usb"

    if not os.path.ismount(usb_path):

        return render_template(
    "index.html",
    usb_error="USB Drive Not Connected",
    usb_connected=False,
    usb_mount=usb_path,
    total_scans=len(get_history())

        )

    scan_data = scan_usb(usb_path)

results = scan_data["results"]
risk = scan_data["risk"]

    scans = get_history()

    total_scans = len(scans)

    return render_template(
    "index.html",
    usb_results=scan_data,
    usb_risk=risk,
    usb_connected=True,
    usb_mount=usb_path,
    total_scans=total_scans
)


@app.route("/download_report")
def download_report():

    if last_target is None:
        return "<h2>No scan available.</h2>"

    pdf = generate_report(
        last_target,
        last_target_type,
        last_ports
    )

    return send_file(
        pdf,
        as_attachment=True
    )


@app.route("/history")
def history():

    scans = get_history()

    return render_template(
        "history.html",
        scans=scans
    )


if __name__ == "__main__":
    app.run(debug=True)
